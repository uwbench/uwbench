{
  "name": "uwbench",
  "version": "0.0.0",
  "private": true,
  "description": "UWBench — Open underwriting benchmark",
  "license": "Apache-2.0",
  "author": "UWBench Contributors",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/uwbench/uwbench.git"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --build",
    "uwbench": "uwbench",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "tsc --build && chmod +x apps/cli/dist/index.js",
    "smoke": "bash scripts/smoke-reasoning-only.sh",
    "generate": "pnpm --filter @uwbench/protocol generate",
    "changeset": "changeset",
    "changeset:check": "changeset status",
    "version": "changeset version",
    "release": "changeset publish",
    "prepare": "husky install || true"
  },
  "dependencies": {
    "@uwbench/cli": "workspace:*"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.7",
    "@eslint/js": "^9.9.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.0.5",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "husky": "^9.1.5",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.65.0",
    "vitest": "^2.0.5"
  }
}

      "ToolFailureResult": {
        "$ref": "../json-schema/tools/ToolFailureResult.json",
        "description": "Failed tool result"
      },
      "ToolError": {
        "$ref": "../json-schema/tools/ToolError.json",
        "description": "Base tool error structure"
      },
      "CaseListDocumentsInput": {
        "$ref": "../json-schema/tools/CaseListDocumentsInput.json",

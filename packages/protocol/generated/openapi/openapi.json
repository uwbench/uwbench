        "description": "Stable agent protocol error code"
      },
      "HealthResponse": {
        "$ref": "../json-schema/agent/HealthResponse.json",
        "description": "Health check response"
      },
      "RunRequest": {
        "$ref": "../json-schema/agent/RunRequest.json",
        "description": "Agent run request"
      },
      "RunStatus": {

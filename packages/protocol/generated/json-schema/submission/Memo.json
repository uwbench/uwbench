{
  "title": "Memo",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "markdown": {
      "type": "string"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim": {
            "type": "string"
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "claim",
          "evidenceIds",
          "confidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "markdown",
    "claims"
  ],
  "additionalProperties": false
}

{
  "title": "RiskFinding",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "riskId": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW",
        "INFORMATIONAL"
      ]
    },
    "weight": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "requiredEvidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptableConcepts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidenceSupport": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "riskId",
    "category",
    "severity",
    "weight"
  ],
  "additionalProperties": false
}

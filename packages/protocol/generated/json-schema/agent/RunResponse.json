{
  "title": "RunResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "agentRunId": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "accepted",
        "running",
        "awaiting_tool",
        "completed",
        "failed",
        "cancelled"
      ]
    }
  },
  "required": [
    "agentRunId",
    "status"
  ],
  "additionalProperties": false
}

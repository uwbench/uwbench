{
  "title": "CaseReadDocumentOutput",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "documentId": {
      "type": "string"
    },
    "sourceId": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pageNumber": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "text": {
            "type": "string"
          },
          "evidence": {
            "type": "object",
            "properties": {
              "sourceId": {
                "type": "string",
                "minLength": 1
              },
              "documentId": {
                "type": "string",
                "minLength": 1
              },
              "page": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "startOffset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "endOffset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "sourceId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "pageNumber",
          "text",
          "evidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "documentId",
    "sourceId",
    "content",
    "pages"
  ],
  "additionalProperties": false
}

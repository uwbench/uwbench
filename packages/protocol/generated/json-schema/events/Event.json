{
  "title": "Event",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "eventId": {
      "type": "string"
    },
    "runId": {
      "type": "string"
    },
    "caseId": {
      "type": "string"
    },
    "sequence": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "source": {
      "type": "string",
      "enum": [
        "RUNNER",
        "AGENT",
        "TOOL_GATEWAY",
        "SCORER"
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "RUN_STARTED",
        "AGENT_READY",
        "AGENT_RUN_STARTED",
        "TOOL_CALL",
        "TOOL_RESULT",
        "TOOL_ERROR",
        "ARTIFACT_SAVED",
        "LIMIT_WARNING",
        "AGENT_COMPLETED",
        "AGENT_FAILED",
        "RUN_CANCELLED",
        "RUN_COMPLETED",
        "SCORING_STARTED",
        "SCORE_COMPONENT_CREATED",
        "SCORING_COMPLETED"
      ]
    },
    "payload": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "previousHash": {
      "type": "string"
    },
    "hash": {
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "eventId",
    "runId",
    "caseId",
    "sequence",
    "timestamp",
    "source",
    "type",
    "payload",
    "previousHash",
    "hash"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
